#include <stdio.h>

int main() {
    int a, b, c;
    int i = 1, j = 1, k = 1;
    int mul1, mul2, mul3;

    scanf("%d %d %d", &a, &b, &c);

    while (1) {
        mul1 = a * i;
        mul2 = b * j;
        mul3 = c * k;

        if (mul1 == mul2 && mul2 == mul3) {
            printf("%d", mul1);
            break;
        }

        if (mul1 <= mul2 && mul1 <= mul3) {
            i++;
        }
        else if (mul2 <= mul1 && mul2 <= mul3) {
            j++;
        }
        else {
            k++;
        }
    }

    return 0;
}